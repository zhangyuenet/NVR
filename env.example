# 复制为 .env 后填写，并执行 chmod 600 .env。.env 已在 .gitignore 中排除。

# NAS（CIFS/SMB 共享，录像目录）
NAS_IP=192.168.1.10
NAS_USER=frigate
NAS_PASS=change-me

# 摄像头 RTSP 账号（Wyze App → 摄像头设置 → 高级设置 → RTSP）
FRIGATE_RTSP_USER=change-me
FRIGATE_RTSP_PASSWORD=change-me

# Pushover（https://pushover.net）
PUSHOVER_TOKEN=change-me
PUSHOVER_USER=change-me

# AI 复核（可选，留空则不启用）
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# 通知里"查看回放"链接的地址（例如 Tailscale Serve 地址）
PUBLIC_URL=https://your-host.your-tailnet.ts.net

TZ=America/Toronto
